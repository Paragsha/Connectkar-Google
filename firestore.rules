rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get user data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user has a document
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper function to check if request is from an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('role', '') == 'ADMIN' ||
        (userExists() && getUserData().get('role', '') == 'ADMIN')
      );
    }

    // Helper to verify a field has not changed between existing resource and new write
    function fieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // Helper to check if resident is verified by an admin
    function verifiedResident() {
      return userExists() && getUserData().get('isVerified', false) == true;
    }

    match /users/{userId} {
      // Allow read: If the user reads their own profile, or is an admin, or resides in the same society
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (userExists() && getUserData().society == resource.data.society)
      );
      
      // On create: Only ADMIN or new resident with unverified/pending status and default role
      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'RESIDENT' &&
          request.resource.data.isVerified == false &&
          request.resource.data.isPending == true &&
          (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'PENDING') &&
          (!('rating' in request.resource.data) || request.resource.data.rating == 0 || request.resource.data.rating == 0.0)
        )
      );

      // On update: ADMIN or self-update where privilege/trust fields remain strictly unchanged
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          fieldUnchanged('role') &&
          fieldUnchanged('verificationStatus') &&
          fieldUnchanged('isVerified') &&
          fieldUnchanged('isPending') &&
          fieldUnchanged('rating') &&
          fieldUnchanged('society') &&
          fieldUnchanged('blockTower') &&
          fieldUnchanged('flatNumber')
        )
      );
        
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      // Read listings only if in the same society, public, explored, or admin
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.isPublic == true ||
        (userExists() && getUserData().society == resource.data.society) ||
        (userExists() && getUserData().exploredSocietyIds.hasAny([resource.data.society]))
      );
      
      // On create, enforce fields (rating and ratingCount cannot be initialized with arbitrary values)
      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.likesCount == 0 &&
          (!('rating' in request.resource.data) || request.resource.data.rating == 0 || request.resource.data.rating == 0.0) &&
          (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0) &&
          userExists() &&
          request.resource.data.society == getUserData().society &&
          verifiedResident()
        )
      );
      
      // On update
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          // If the author themselves is updating, lock rating/ratingCount/likesCount
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.society == resource.data.society &&
          fieldUnchanged('rating') &&
          fieldUnchanged('ratingCount') &&
          fieldUnchanged('likesCount')
        ) ||
        (
          // If a neighbor is liking the listing (aggregate likesCount only)
          userExists() &&
          (resource.data.isPublic == true || getUserData().society == resource.data.society) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
        )
      );
      
      // Only author or admin can delete
      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.authorUid == request.auth.uid
      );

      // Per-user interactions (likes and bookmarks)
      match /interactions/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Reviews subcollection for aggregate ratings
      match /reviews/{reviewId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          (userExists() && getUserData().society == get(/databases/$(database)/documents/listings/$(listingId)).data.society)
        );
        allow create: if request.auth != null &&
          request.resource.data.authorUid == request.auth.uid &&
          userExists();
        allow update, delete: if request.auth != null && (
          isAdmin() ||
          resource.data.authorUid == request.auth.uid
        );
      }
    }

    match /chefProfiles/{chefUid} {
      allow read: if request.auth != null && (
        isAdmin() ||
        (userExists() && getUserData().society == resource.data.society)
      );

      allow create, update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == chefUid &&
          userExists() &&
          request.resource.data.society == getUserData().society
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == chefUid
      );
    }

    match /menuItems/{menuItemId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        (userExists() && getUserData().society == resource.data.society)
      );

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.chefUid == request.auth.uid &&
          userExists() &&
          request.resource.data.society == getUserData().society
        )
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.chefUid == request.auth.uid &&
          request.resource.data.chefUid == resource.data.chefUid &&
          request.resource.data.society == resource.data.society
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.chefUid == request.auth.uid
      );
    }

    function getMenuItemDocId(data) {
      return ('menuItemFirestoreId' in data && data.menuItemFirestoreId is string && data.menuItemFirestoreId.size() > 0)
        ? data.menuItemFirestoreId
        : (('menuItemDocId' in data && data.menuItemDocId is string && data.menuItemDocId.size() > 0)
          ? data.menuItemDocId
          : string(data.menuItemId));
    }

    function isValidMealOrderPricing(data) {
      let docId = getMenuItemDocId(data);
      let menuItemPath = /databases/$(database)/documents/menuItems/$(docId);
      let hasMenuItem = exists(menuItemPath);
      let menuItem = get(menuItemPath).data;
      let expectedItemTotal = menuItem.price * data.servingSize;
      let expectedDeliveryFee = (data.deliveryMethod == 'DOORSTEP' || data.deliveryMethod == 'Doorstep Delivery' || data.deliveryMethod == 'SOCIETY_RUNNER') ? 20.0 : 0.0;

      return hasMenuItem &&
        data.servingSize is int && data.servingSize > 0 &&
        data.itemTotal is number &&
        data.addOnsTotal is number && data.addOnsTotal >= 0.0 &&
        data.deliveryFee is number && data.deliveryFee >= 0.0 &&
        data.grandTotal is number &&
        (
          ((data.deliveryMethod == 'DOORSTEP' || data.deliveryMethod == 'Doorstep Delivery' || data.deliveryMethod == 'SOCIETY_RUNNER') && 
           (data.deliveryFee == 20.0 || data.deliveryFee == 20)) ||
          ((data.deliveryMethod == 'PICKUP' || data.deliveryMethod == 'Self-Pickup' || data.deliveryMethod == 'SELF_PICKUP') && 
           (data.deliveryFee == 0.0 || data.deliveryFee == 0))
        ) &&
        (data.itemTotal == expectedItemTotal) &&
        (data.grandTotal == data.itemTotal + data.addOnsTotal + data.deliveryFee) &&
        (data.grandTotal == expectedItemTotal + data.addOnsTotal + expectedDeliveryFee);
    }

    function isValidMealSubscriptionPricing(data) {
      return data.pricePerMeal is number && data.pricePerMeal > 0.0 &&
        data.mealsPerCycle is int && data.mealsPerCycle > 0 &&
        data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 100;
    }

    match /mealOrders/{orderId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid ||
        resource.data.chefUid == request.auth.uid ||
        (userExists() && getUserData().society == resource.data.society)
      );

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.buyerUid == request.auth.uid &&
          userExists() &&
          request.resource.data.society == getUserData().society &&
          (
            request.auth.token.get('source', '') == 'server' ||
            request.auth.token.get('server', false) == true ||
            isValidMealOrderPricing(request.resource.data)
          )
        )
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.chefUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'eta', 'deliveryWindow', 'timestamp', 'serverTimestamp'])
        ) ||
        (
          resource.data.buyerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timestamp', 'serverTimestamp'])
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid
      );
    }

    match /mealSubscriptions/{subscriptionId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid ||
        resource.data.chefUid == request.auth.uid ||
        (userExists() && getUserData().society == resource.data.society)
      );

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.buyerUid == request.auth.uid &&
          userExists() &&
          request.resource.data.society == getUserData().society &&
          (
            request.auth.token.get('source', '') == 'server' ||
            request.auth.token.get('server', false) == true ||
            isValidMealSubscriptionPricing(request.resource.data)
          )
        )
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.chefUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timestamp', 'serverTimestamp'])
        ) ||
        (
          resource.data.buyerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timestamp', 'serverTimestamp'])
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid
      );
    }
  }
}
